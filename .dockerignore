# VCS / CI
.git
.github
.gitlab-ci.yml

# Editor / tooling
.vscode
.zed
.pre-commit-config.yaml

# Python build noise (nested patterns so they match under backend/ too)
**/.venv/
**/__pycache__/
**/*.pyc
**/.ruff_cache/
**/.pytest_cache/
.coverage
htmlcov/

# Runtime / local artifacts
dumps/
backend/media/
backend/static/
backend/logs/
backend/celerybeat-schedule

# Docs & env
*.md
docs/
.env
.env.example
.dockerignore
.gitignore

# Credentials — the runtime stage does `COPY backend/ .`, so anything matching these
# patterns must never reach the build context or it gets baked into the pushed image.
# A PUBLIC cert the image legitimately needs (e.g. a managed-Postgres CA bundle) must be
# re-included with a negation line below these, e.g. `!backend/certs/ca.pem`.
**/firebase_credentials/
**/*credentials*.json
**/*service*account*.json
**/*.pem
**/*.key
